# CSE Mastery Environment Configuration

# Database (Serverless Postgres / Neon)
DATABASE_URL="postgresql://neondb_owner:npg_sample@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Demo Mode Flag (Set to "true" to run with bundled real historical CSE data and zero external dependencies)
USE_DEMO_DATA="false"

# CSE Data Provider (CSE_LIVE | DEMO | CSV_IMPORT)
CSE_PROVIDER="CSE_LIVE"

# Vercel Cron & Background Jobs Secret
CRON_SECRET="cse_mastery_cron_secret_key_change_me_in_prod"

# AI Provider Configuration (gemini | groq | openrouter | mock)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Auth & Session Security
JWT_SECRET="cse_mastery_super_secret_jwt_key_min_32_chars_long_123456"
NEXTAUTH_SECRET="cse_mastery_super_secret_jwt_key_min_32_chars_long_123456"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Upstash Redis (Serverless Caching & Single-flight Mutex)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Vercel Blob (Optional for CSV imports)
BLOB_READ_WRITE_TOKEN=""
